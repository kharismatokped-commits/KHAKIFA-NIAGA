# Supabase Database Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# PostgreSQL Connection Strings (Prisma)
# Gunakan port 6543 (transaction pooler) untuk DATABASE_URL
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Gunakan port 5432 (session pooler/direct) untuk DIRECT_URL
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Better Auth Configuration
BETTER_AUTH_SECRET="generate-a-32-char-random-secret"
BETTER_AUTH_URL="https://your-domain.com"
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXT_PUBLIC_WA_MESSAGE="Halo, saya tertarik belanja di Khalifa Niaga"
